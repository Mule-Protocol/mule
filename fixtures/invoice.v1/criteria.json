{
  "model": "invoice.v1",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "supplier",
      "date",
      "number",
      "currency",
      "total_amount",
      "line_items"
    ],
    "properties": {
      "supplier": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "date": {
        "type": "string",
        "format": "date"
      },
      "number": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "currency": {
        "type": "string",
        "pattern": "^[A-Z]{3}$"
      },
      "total_amount": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]{0,17})\\.[0-9]{2}$"
      },
      "line_items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 100,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "description",
            "amount"
          ],
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "amount": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,17})\\.[0-9]{2}$"
            }
          }
        }
      }
    }
  },
  "crossChecks": [
    "invoice.total_matches_lines"
  ]
}
