    "@solana/spl-token": "0.4.14",
    "@types/node": "22.18.10",
    "@types/bn.js": "5.2.0",
    "typescript": "5.9.3",
    "tsx": "4.20.6",
    "eslint": "9.37.0",
    "typescript-eslint": "8.46.1",
    "litesvm": "0.8.0"
  }
}
